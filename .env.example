# Copy to .env (gitignored) and fill in what you have. Nothing here is required
# for tests, dataset generation, baselines or replay runs.

# Anthropic Messages API (provider: anthropic)
ANTHROPIC_API_KEY=

# OpenAI or any OpenAI-compatible endpoint (provider: openai_compatible)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Self-hosted servers (providers: openai_compatible / anthropic_compatible).
# Endpoint URLs stay here, never in committed experiment configs.
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=

# Subscription CLIs (providers: claude_cli, codex_cli, grok_cli) use the CLI's
# own login; no variables needed.
