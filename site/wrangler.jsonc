// Cloudflare Worker that serves this directory as static assets (no Worker script).
// Workers Builds uses site/ as its root directory, so the build never sees the Python harness.
// Deployed on push to main; other branches get preview URLs.
{
  "name": "identitybench",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "preview_urls": true,
  // Branch builds run `npx wrangler preview`, which refuses to run without this block. It can be
  // empty: assets and compatibility settings are read from the top level.
  "previews": {}
}
