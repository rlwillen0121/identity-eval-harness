{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrate",
  "agent": {
    "orchestrate": {
      "description": "IdentityBench contributor coordinator. No direct source edits and no live model runs.",
      "mode": "primary",
      "permission": {
        "edit": "deny",
        "task": {
          "*": "deny",
          "implement": "allow",
          "review": "allow",
          "lane-blind-conformance": "allow"
        },
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "ls*": "allow",
          "rg *": "allow",
          "grep *": "allow",
          "cat *": "allow",
          "uv run pytest*": "allow",
          "uv run ruff check*": "allow",
          "uv run mypy*": "allow",
          "uv run identitybench v41 validate*": "allow",
          "uv run identitybench v41 score*": "allow",
          "uv run identitybench v41 verify*": "allow"
        }
      }
    },
    "implement": {
      "description": "IdentityBench implementer. Edits named files and runs free local verification only. Never calls live models.",
      "mode": "subagent",
      "permission": {
        "edit": "allow",
        "task": "deny"
      }
    },
    "review": {
      "description": "IdentityBench review composer. Fans out hidden blind lanes; no source edits.",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "task": {
          "*": "deny",
          "lane-rules": "allow",
          "lane-security": "allow",
          "lane-oracle": "allow",
          "lane-blind-conformance": "allow",
          "lane-stats": "allow"
        },
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "ls*": "allow",
          "rg *": "allow",
          "grep *": "allow",
          "cat *": "allow",
          "uv run pytest*": "allow",
          "uv run ruff check*": "allow",
          "uv run mypy*": "allow",
          "uv run identitybench v41 validate*": "allow",
          "uv run identitybench v41 score*": "allow",
          "uv run identitybench v41 verify*": "allow",
          "rm *": "deny",
          "git push*": "deny",
          "git commit*": "deny",
          "git reset*": "deny",
          "git checkout*": "deny"
        }
      }
    },
    "bench-operator": {
      "description": "IdentityBench operator. Runs live model evaluations and reports when explicitly requested; no repo edits.",
      "mode": "primary",
      "permission": {
        "edit": "deny",
        "task": "deny",
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "ls*": "allow",
          "rg *": "allow",
          "grep *": "allow",
          "cat *": "allow",
          "uv run pytest*": "allow",
          "uv run ruff check*": "allow",
          "uv run mypy*": "allow",
          "uv run identitybench v41 validate*": "allow",
          "uv run identitybench v41 score*": "allow",
          "uv run identitybench v41 verify*": "allow",
          "uv run identitybench v41 run*": "allow",
          "uv run identitybench v41 report*": "allow"
        }
      }
    },
    "lane-rules": {
      "description": "IdentityBench blind rules review lane. Read-only; no live models.",
      "mode": "subagent",
      "permission": {
