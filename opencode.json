{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrate",
  "agent": {
    "orchestrate": {
      "description": "IdentityBench contributor coordinator. No direct source edits and no live model runs.",
      "mode": "primary",
      "permission": {
        "edit": "deny",
        "task": {
          "*": "deny",
          "implement": "allow",
          "review": "allow",
          "lane-blind-conformance": "allow",
          "lane-rules": "allow",
          "lane-security": "allow",
          "lane-oracle": "allow",
          "lane-stats": "allow"
        },
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "ls*": "allow",
          "rg *": "allow",
          "grep *": "allow",
          "cat *": "allow",
          "cargo test*": "allow",
          "cargo fmt*": "allow",
          "cargo clippy*": "allow",
          "cargo check*": "allow",
          "cargo build*": "allow",
          "node --test*": "allow",
          "./target/release/identitybench v5 validate*": "allow",
          "./target/release/identitybench v5 score*": "allow",
          "./target/release/identitybench v5 report*": "allow"
        }
      }
    },
    "implement": {
      "description": "IdentityBench implementer. Edits named files and runs free local verification only. Never calls live models.",
      "mode": "subagent",
      "permission": {
        "edit": "allow",
        "task": "deny",
        "bash": {
          "*identitybench v5 run*": "deny"
        }
      }
    },
    "review": {
      "description": "IdentityBench review composer. Fans out hidden blind lanes; no source edits.",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "task": {
          "*": "deny",
          "lane-rules": "allow",
          "lane-security": "allow",
          "lane-oracle": "allow",
          "lane-blind-conformance": "allow",
          "lane-stats": "allow"
        },
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "ls*": "allow",
          "rg *": "allow",
          "grep *": "allow",
          "cat *": "allow",
          "cargo test*": "allow",
          "cargo fmt*": "allow",
          "cargo clippy*": "allow",
          "cargo check*": "allow",
          "node --test*": "allow",
          "./target/release/identitybench v5 validate*": "allow",
          "./target/release/identitybench v5 score*": "allow",
          "rm *": "deny",
          "git push*": "deny",
          "git commit*": "deny",
          "git reset*": "deny",
          "git checkout*": "deny"
        }
      }
    },
    "bench-operator": {
      "description": "IdentityBench operator. Runs live model evaluations and reports when explicitly requested; no repo edits.",
      "mode": "primary",
      "permission": {
        "edit": "deny",
        "task": "deny",
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "ls*": "allow",
          "rg *": "allow",
          "grep *": "allow",
          "cat *": "allow",
          "cargo test*": "allow",
          "cargo build*": "allow",
          "./target/release/identitybench v5 validate*": "allow",
          "./target/release/identitybench v5 score*": "allow",
          "./target/release/identitybench v5 run*": "allow",
          "./target/release/identitybench v5 report*": "allow"
        }
      }
    },
    "lane-rules": {
      "description": "IdentityBench blind rules review lane. Read-only; no live models.",
      "mode": "subagent",
