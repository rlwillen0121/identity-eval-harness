          "git log*": "allow",
          "git show*": "allow",
          "ls*": "allow",
          "rg *": "allow",
          "grep *": "allow",
          "cat *": "allow",
          "cargo test*": "allow",
          "./target/release/identitybench v5 validate*": "allow",
